{
  "applicationId": "js.lwmark.app",
  "applicationName": "LWmark",
  "description": "轻量简约的本地 Markdown 编辑器",
  "version": "1.2.3",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "window.*",
    "storage.*",
    "debug.*"
  ],
  "modes": {
    "window": {
      "title": "LWmark",
      "width": 1120,
      "height": 760,
      "minWidth": 720,
      "minHeight": 520,
      "center": true,
      "resizable": true,
      "maximizable": true,
      "borderless": true,
      "transparent": false,
      "exitProcessOnClose": true,
      "icon": "/icon.png"
    }
  },
  "cli": {
    "binaryName": "lwmark",
    "resourcesPath": "/dist/",
    "extensionsPath": "/extensions/",
    "distributionPath": "/release/",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
